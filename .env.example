# 街头饭签 · 配置样例
#
# 用法：
#   cp .env.example .env      # 本机运行；.env 已被 .gitignore 忽略，不要提交
#   docker compose up -d      # Docker：compose 会自动读取同目录的 .env 做变量插值
#
# 下面每一项默认都是「注释状态」，表示使用代码内置默认值——不配任何东西也能跑起来
# （内置纸上地图 + 空数据库）。需要改哪一项就取消该行注释并填值。
#
# 为什么不用「键=空值」的写法：空字符串会被当成显式配置，DATA_DIR= 会让程序
# 把项目根目录当成数据目录。要覆盖就填真实值，不要留空。
#
# 完整说明见 docs/CONFIGURATION.md。

# ── 后台管理员 ───────────────────────────────────────────────
# 首次启动时用于初始化后台密码（≥12 字符）。建议至少配这一项，否则无法登录后台。
# ADMIN_PASSWORD=change-me-to-a-long-password
# 已有密码哈希时优先于 ADMIN_PASSWORD。生成：npm run admin:password
# ADMIN_PASSWORD_HASH=
# 后台登录名，默认 admin。
# ADMIN_USERNAME=admin

# ── 会话与安全 ───────────────────────────────────────────────
# 后台会话签名 + 匿名来源指纹盐，必须 ≥32 字符。
# 留空时：本机由 npm run setup 生成并写入 .env.local；容器首次启动自动生成并持久化到 /data/.session-secret。
# SESSION_SECRET=
# 仅当可信反向代理会剥离客户端自带的 X-Forwarded-For 时才设为 1（代码取首个 XFF 值）。
# TRUST_PROXY=0

# ── 数据与存储 ───────────────────────────────────────────────
# 本机默认 data/、uploads/、backups/；容器镜像内默认 /data、/data/uploads、/data/backups。
# DATA_DIR=/data
# DATABASE_PATH=/data/budget-map.sqlite
# UPLOADS_DIR=/data/uploads
# BACKUPS_DIR=/data/backups

# ── 首次启动行为 ─────────────────────────────────────────────
# 1 = 写入演示门店（适合本地体验，默认）；0 = 只写区域目录，从空数据开始（适合生产）。
# SEED_DEMO=0

# ── 地图 ─────────────────────────────────────────────────────
# demo = 内置纸上地图（无需网络与密钥，默认）；tencent = 腾讯 JS API GL。
# 注意：NEXT_PUBLIC_* 在构建期被内联，Docker 部署需在 build 阶段提供（见 docker-compose.yml）。
# NEXT_PUBLIC_MAP_MODE=tencent
# NEXT_PUBLIC_TENCENT_MAP_KEY=
# 服务端腾讯 WebService Key，用于「地址 → GCJ-02 坐标」。留空则降级为人工填坐标。
# TENCENT_MAP_WEB_SERVICE_KEY=

# ── 采集脚本（可选）──────────────────────────────────────────
# B站 Cookie（如 buvid3=...），用于降低 npm run collect:creators 的 -412 限流。
# BILIBILI_COOKIE=
# MiniMax API Key，用于 npm run collect:web 的文章抽取。不要提交真实值。
# MINIMAX_API_KEY=
# MiniMax 适配器可选覆盖。默认 base https://api.minimaxi.com/v1，model MiniMax-M2。
# MINIMAX_BASE_URL=
# MINIMAX_MODEL=
