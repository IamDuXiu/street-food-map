# ════════════════════════════════════════════════════════════════════
#  街头饭签 · 配置模板
# ════════════════════════════════════════════════════════════════════
#
#  用法
#    Docker：  cp .env.example .env   →  取消注释并填写  →  docker compose up -d
#    本机：    cp .env.example .env   →  取消注释并填写  →  npm install && npm run setup && npm run dev
#
#  这是本项目唯一的配置文件。Next.js、Docker Compose 与 scripts/ 下的脚本
#  （含 npm run preflight / collect:*）都会读取它；已导出的进程环境变量优先级最高。
#
#  ── 关于第三方凭据（请先读）─────────────────────────────────────────
#  1. 腾讯地图 Key、大模型 Key 都是**第三方账号凭据**，必须由你本人申请。
#     本仓库和镜像里不包含任何 Key，也不提供公共 Key 给大家共用。
#  2. 借用别人的 Key 通常也走不通：腾讯位置服务的 Key 可在控制台绑定域名白名单
#     （浏览器端）或 IP 白名单（服务端）；大模型 Key 按调用量计入申请者账号的账单，
#     共享会同时带来费用与封号风险。
#  3. 不配置这些 Key 也能把站点跑起来：地图会回退成内置的“纸上地图”，后台改成人工
#     填坐标，采集脚本则需要你自备 Key。具体见下面每一项的“不配置的后果”。
#
#  ── 部署前自查 ──────────────────────────────────────────────────
#      npm run preflight        严格模式：配置错误（选了腾讯底图却没给 Key、
#                               SESSION_SECRET 太短、数据目录不可写）会以退出码 1 结束
#      npm run preflight -- --warn-only    只报告，不失败
#     容器里同样会打印这份清单，见 docker compose logs app 的开头。
#
#  ── 写法注意 ────────────────────────────────────────────────────
#     不要写 `KEY=`（空值会被当成显式配置：例如 DATA_DIR= 会让程序把当前目录当数据目录）。
#     要覆盖就填真实值，否则保持注释状态。
# ════════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────
# 一、建议现在就设置（缺失会让后台不可用）
# ────────────────────────────────────────────────────────────────────

# 管理员密码，用来初始化 /admin 的登录（≥12 字符）。
# 不配置的后果：前台地图、投稿、公开接口照常工作，但后台无法登录，投稿无法审核。
# 只在首次初始化时使用；之后建议改用下面的 ADMIN_PASSWORD_HASH。
# ADMIN_PASSWORD=change-me-to-a-long-password

# 管理员密码哈希（优先于 ADMIN_PASSWORD）。生成：npm run admin:password
# ADMIN_PASSWORD_HASH=

# 后台登录名，默认 admin。
# ADMIN_USERNAME=admin

# 后台会话签名 + 匿名来源指纹盐，必须 ≥32 字符。
# 不配置的后果：容器首启会自动生成并持久化到 /data/.session-secret；本机由 npm run setup
# 生成到 .env.local。显式设置的好处是换机器/重建卷后旧会话不会失效。
# SESSION_SECRET=


# ────────────────────────────────────────────────────────────────────
# 二、想要腾讯真实底图时才需要（默认使用内置“纸上地图”，无需任何 Key）
# ────────────────────────────────────────────────────────────────────

# demo = 内置纸上地图（默认，不需要网络与账号）；tencent = 腾讯 JS API GL。
# 不配置的后果：保持 demo，地图仍可用，只是没有真实底图。
# NEXT_PUBLIC_MAP_MODE=tencent

# 腾讯位置服务「浏览器端（JS API GL）」Key，需在腾讯控制台绑定**你自己的域名**白名单。
# 不配置的后果：若上面选了 tencent，地图会安全回退为内置纸上地图（preflight 会报错）。
# ⚠️ NEXT_PUBLIC_* 会被 Next.js 在构建期内联，Docker 部署必须重新 build 才生效。
# NEXT_PUBLIC_TENCENT_MAP_KEY=

# 腾讯位置服务「服务端（WebService）」Key，用于后台把地址自动转成 GCJ-02 坐标。
# 不配置的后果：后台注册与导入改为人工填写 / 点选坐标，功能不受影响。
# TENCENT_MAP_WEB_SERVICE_KEY=


# ────────────────────────────────────────────────────────────────────
# 三、只有跑采集脚本时才需要（完全选填，不影响站点运行）
# ────────────────────────────────────────────────────────────────────

# npm run collect:creators 用：B站 Cookie（形如 buvid3=...），降低 -412 限流概率。
# 不配置的后果：仍可匿名抓取，只是更容易被限流。
# BILIBILI_COOKIE=

# npm run collect:web 用：大模型 Key（OpenAI 兼容接口），按你的账号计费。
# 不配置的后果：该采集脚本不可用；站点运行与后台人工录入不受影响。
# MINIMAX_API_KEY=
# 可选覆盖：默认 base https://api.minimaxi.com/v1，model MiniMax-M2
# MINIMAX_BASE_URL=
# MINIMAX_MODEL=


# ────────────────────────────────────────────────────────────────────
# 四、运行参数（都有合理默认值，通常不用改）
# ────────────────────────────────────────────────────────────────────

# 1 = 首次启动写入演示门店（本地体验，默认）；0 = 只写区域目录，从空数据开始（生产建议）。
# SEED_DEMO=0

# 数据、上传图片、备份的位置。本机默认 data/ uploads/ backups/；容器镜像内默认 /data/*。
# DATA_DIR=/data
# DATABASE_PATH=/data/budget-map.sqlite
# UPLOADS_DIR=/data/uploads
# BACKUPS_DIR=/data/backups

# 仅供 docker-compose 映射宿主机端口（默认 3000）。
# HTTP_PORT=8080

# 仅当可信反向代理会剥离客户端自带的 X-Forwarded-For 时才设为 1（代码取首个 XFF 值）。
# TRUST_PROXY=0
