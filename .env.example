# DemoMapAdapter works without a key. Set tencent only for local Tencent JS API GL testing.
NEXT_PUBLIC_MAP_MODE=demo
NEXT_PUBLIC_TENCENT_MAP_KEY=
DATABASE_PATH=data/budget-map.sqlite
DATA_DIR=data
UPLOADS_DIR=uploads
BACKUPS_DIR=backups
# Generate with npm run admin:password. Never commit the resulting value.
ADMIN_PASSWORD_HASH=
# Local administrator login name; defaults to admin.
ADMIN_USERNAME=admin
# Use a random 32+ character value for real deployments.
SESSION_SECRET=
# Only set to 1 when a trusted reverse proxy strips client-supplied X-Forwarded-For.
TRUST_PROXY=0
