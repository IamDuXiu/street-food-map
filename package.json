{
  "name": "street-food-map",
  "version": "0.1.0",
  "private": true,
  "description": "街头饭签 · 平价餐食地图：按「具体餐食 + 具体价格 + 具体核验日期」记录一座城市的便宜饭吃在哪。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamDuXiu/street-food-map.git"
  },
  "homepage": "https://github.com/IamDuXiu/street-food-map#readme",
  "bugs": {
    "url": "https://github.com/IamDuXiu/street-food-map/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "street-food",
    "restaurant",
    "map",
    "budget",
    "sqlite",
    "nextjs",
    "open-data",
    "china"
  ],
  "overrides": {
    "postcss": ">=8.5.23",
    "sharp": "0.35.5"
  },
  "scripts": {
    "setup": "tsx scripts/setup-demo.ts",
    "preflight": "tsx scripts/preflight.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "dev": "next dev --webpack",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "admin:password": "tsx scripts/admin-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "fresh-start": "node --import tsx scripts/fresh-start-check.mjs",
    "phase5:check": "node scripts/phase5-check.mjs",
    "seed:candidates": "tsx scripts/seed-candidate-pool.ts",
    "seed:regions": "tsx scripts/seed-regions.ts",
    "collect:creators": "tsx scripts/creator-collect.ts",
    "collect:web": "tsx scripts/web-collect.ts"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "next": "16.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.7.4",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.27.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "vitest": "2.1.2"
  }
}
