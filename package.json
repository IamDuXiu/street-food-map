{
  "name": "shenzhen-budget-map",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": ">=8.5.23",
    "sharp": "0.35.4"
  },
  "scripts": {
    "setup": "tsx scripts/setup-demo.ts",
    "dev": "next dev --webpack",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "admin:password": "tsx scripts/admin-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "fresh-start": "node --import tsx scripts/fresh-start-check.mjs",
    "phase5:check": "node scripts/phase5-check.mjs",
    "seed:candidates": "tsx scripts/seed-candidate-pool.ts",
